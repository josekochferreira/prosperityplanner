# Sharesight OAuth2 credentials
# Create an API application at https://portfolio.sharesight.com/oauth_consumers/new
SHARESIGHT_CLIENT_ID=your_client_id_here
SHARESIGHT_CLIENT_SECRET=your_client_secret_here

# Optional: pin a specific portfolio ID (leave blank to list all)
SHARESIGHT_PORTFOLIO_ID=

# Buxfer credentials (same email/password you use at buxfer.com)
BUXFER_EMAIL=you@example.com
BUXFER_PASSWORD=your_password_here

# Supabase (server-side only; never expose the service-role key to a browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
